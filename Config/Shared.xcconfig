// Shared build settings for TRINKA's app targets.
// Override values locally in Config/Secrets.xcconfig (git-ignored), e.g.:
//   NCBI_CONTACT_EMAIL = you@example.com
//   NCBI_API_KEY = ...
//   DEVELOPMENT_TEAM = ABCDE12345
//   QUESTION_SERVICE_HOST = trinka-question-service.your-account.workers.dev
//   QUESTION_SERVICE_TOKEN = the APP_TOKEN you set on the service (optional)
//   QUESTION_BANK_BASE = your-host/path/to/Content   (newer question banks; empty = updates off)
// (Write hosts without https:// — "//" starts a comment in xcconfig files.)

NCBI_CONTACT_EMAIL =
NCBI_API_KEY =
QUESTION_SERVICE_HOST =
QUESTION_SERVICE_TOKEN =
// Published question banks (Content/ on the main branch). The app checks it at launch.
QUESTION_BANK_BASE = raw.githubusercontent.com/juanmarcosmoreno-arch/Trinka/main/Content

#include? "Secrets.xcconfig"
