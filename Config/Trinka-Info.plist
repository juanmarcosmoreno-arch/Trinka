<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys Xcode generates from build settings (INFOPLIST_KEY_*). -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>es</string>
	</array>
	<!-- Static launch screen in the intro video's background color, so the animated logo starts seamlessly. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.trinka.app.challenge</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>trinka</string>
			</array>
		</dict>
	</array>
	<!-- NCBI asks E-utilities clients to send a contact e-mail. Set it per build in Config/Secrets.xcconfig. -->
	<key>NCBIContactEmail</key>
	<string>$(NCBI_CONTACT_EMAIL)</string>
	<!-- Optional NCBI API key (raises the rate limit to 10 req/s). Not an AI credential. -->
	<key>NCBIAPIKey</key>
	<string>$(NCBI_API_KEY)</string>
	<!-- TRINKA question service (Backend/question-service). Empty = topic quizzes disabled. -->
	<key>TrinkaQuestionServiceHost</key>
	<string>$(QUESTION_SERVICE_HOST)</string>
	<key>TrinkaQuestionServiceToken</key>
	<string>$(QUESTION_SERVICE_TOKEN)</string>
	<!-- Only standard HTTPS is used, so App Store Connect skips the export-compliance question. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Where newer question banks are published (Content/manifest.json). Empty = no remote updates. -->
	<key>TrinkaQuestionBankBase</key>
	<string>$(QUESTION_BANK_BASE)</string>
</dict>
</plist>
